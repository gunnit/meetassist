{
  "manifest_version": 3,
  "name": "AI Sales Assistant MVP",
  "version": "0.1.0",
  "description": "AI-powered sales suggestions during meetings",
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": [
      "https://meet.google.com/*",
      "https://zoom.us/*",
      "https://*.zoom.us/*"
    ],
    "js": ["content.js"]
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Sales Assistant"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}